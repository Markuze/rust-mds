# Dev-cluster cephx secrets for the capture-based golden tests. Copy this file to .env (git
# ignores it) and fill in the values; a test whose value is missing prints a note and skips.
# Never commit keys.
#
# The values must be the ones in force when the captures were taken (dev cluster fsid
# 3ceca2c6-851f-41cf-b538-1cfded4f1e82, 2026-10-11). devcluster/reset.sh makes new keys, so
# new captures (testdata/capture.sh) need new values. All are base64 CryptoKeys, as in a keyring.

# client.admin (`ceph auth get-key client.admin`): kernel-v1, fuse-v1 and fuse-v2 captures.
RMDS_TEST_CLIENT_ADMIN_KEY=
# mds.a (`ceph auth get-key mds.a`): mds-v1-boot capture, crates/monc/tests/capture_golden.rs.
RMDS_TEST_MDS_A_KEY=
# The rotating "mds" service secret with id 2 (the secret_id of the kernel-v1 ticket), fetched
# at capture time by authenticating as mds.rust: crates/msgr/tests/kernel_capture.rs.
# Rotating secrets expire within hours, so it cannot be fetched later.
RMDS_TEST_MDS_ROTATING_SECRET_2=
